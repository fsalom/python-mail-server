server {
    listen 80;
    server_name tickets.rudo.es;

    # Redirigir todas las solicitudes a HTTPS
    return 301 https://$host$request_uri;
}

# Configuración para HTTPS
server {
    listen 443 ssl;
    server_name tickets.rudo.es;

    # Ruta a los certificados SSL
    ssl_certificate /etc/ssl/certs/tickets.rudo.es.crt;
    ssl_certificate_key /etc/ssl/private/tickets.rudo.es.key;

    # Mejora de la seguridad SSL
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Tamaño máximo para el cuerpo de la solicitud
    client_max_body_size 512M;

    # Manejo de las solicitudes al backend
    location / {
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location /api/ {
        proxy_pass http://app:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # Manejo de archivos estáticos
    location /static/ {
        alias /infrastructure/static/;
    }

    location /media/ {
        alias /media/;
    }
}
